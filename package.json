{
  "name": "drone",
  "version": "1.0.0",
  "description": "````markdown # Offline ISR Drone Feed & Geospatial COP",
  "main": "electron/main.js",
  "build": {
    "appId": "com.sentinel.cop.desktop",
    "productName": "Sentinel COP",
    "npmRebuild": false,
    "files": [
      "electron/**",
      "adapters/**",
      "core/**",
      "database/**",
      "client/dist/**",
      "package.json"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production electron .",
    "dev": "cross-env NODE_ENV=development concurrently \"cd client && npm run dev\" \"wait-on tcp:5173 && electron .\"",
    "build": "cd client && npm run build && cd .. && electron-builder",
    "test": "node tests/dji.test.js && node tests/coordinates/engine.test.js && node --test tests/bridge/*.test.cjs",
    "test:desktop": "node scripts/electron-smoke.cjs",
    "simulate:dji": "node scripts/simulate_dji_stream.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "playwright": "^1.64.1",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "mavlink-mappings": "^1.0.22-20260311",
    "mgrs": "^2.2.0",
    "node-mavlink": "^2.3.0",
    "serialport": "^13.0.0"
  }
}
