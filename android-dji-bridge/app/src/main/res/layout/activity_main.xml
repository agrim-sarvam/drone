<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Height set to 16:9 of the width in MainActivity. -->
    <TextureView
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="200dp" />

    <TextView
        android:id="@+id/video_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Camera: connect the aircraft to see live video" />

    <TextView
        android:id="@+id/dji_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DJI SDK: DISCONNECTED"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/aircraft_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aircraft: DISCONNECTED"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/udp_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UDP: NOT CONFIGURED"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">
        
        <EditText
            android:id="@+id/ip_input"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Windows IP"
            android:inputType="phone" />
            
        <EditText
            android:id="@+id/port_input"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="Port"
            android:text="14550"
            android:inputType="number" />
    </LinearLayout>

    <Button
        android:id="@+id/register_button"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="RETRY DJI REGISTRATION / PERMISSIONS" />
    <Button
        android:id="@+id/export_button"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="SAVE DIAGNOSTIC REPORT" />
    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Telemetry only. Stop UDP before editing destination. Test packets are synthetic. Reports remain local until you share them." />
    <Button
        android:id="@+id/start_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="START UDP"
        android:layout_marginTop="16dp" />
        
    <Button
        android:id="@+id/test_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SEND STATIC TEST PACKET"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/telemetry_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="No Telemetry"
        android:textSize="16sp"
        android:fontFamily="monospace" />

</LinearLayout>
</ScrollView>
